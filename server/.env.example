PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/kisanexpress-demo
ALLOW_MEMORY_FALLBACK=true
AUTO_SEED_DEMO=true
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Optional real-data providers. Keep all secrets only in server/.env or Vercel environment variables.
DATA_GOV_API_KEY=your-data-gov-api-key
MANDI_PRICE_API_URL=https://api.data.gov.in/resource/...
OPENAI_API_KEY=your-openai-api-key
ROUTE_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
